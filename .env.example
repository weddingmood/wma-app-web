# ============================================
# WEDDING MOOD — Variables d'environnement
# Copier vers .env puis renseigner les vraies valeurs.
# Ne JAMAIS commiter le fichier .env sur GitHub.
# ============================================

# --- Base de données ---
# Local / Docker :
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Supabase (Transaction Pooler, recommandé sur Vercel) :
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Application ---
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://weddingmood.ci
SESSION_SECRET=generer-avec-openssl-rand-base64-32

# --- Compte administrateur initial (seed) ---
ADMIN_EMAIL=admin@weddingmood.ci
ADMIN_PASSWORD=Admin@2025!WM
ADMIN_NAME=Direction Wedding Mood

# --- Contacts officiels (publics) ---
NEXT_PUBLIC_WHATSAPP_CONTACT=https://wa.me/22570501356
NEXT_PUBLIC_WAVE_PAY_COUPLE_URL=https://pay.wave.com/m/M_W9fOyOGfFiNN/c/ci/?amount=3000
NEXT_PUBLIC_WAVE_PAY_INDIVIDUAL_URL=https://pay.wave.com/m/M_W9fOyOGfFiNN/c/ci/?amount=2000

# --- Application mobile (TWA / APK) ---
NEXT_PUBLIC_ANDROID_PACKAGE=ci.weddingmood.app
NEXT_PUBLIC_APK_VERSION=1.0.0
